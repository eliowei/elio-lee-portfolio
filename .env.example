# Copy to `.env` for local development; on Vercel set the same names under Project Settings → Environment Variables.
# Every NUXT_PUBLIC_* value is shipped to the browser by design, so never put a secret here.

# Canonical site URL (canonical / hreflang / og:url / sitemap / JSON-LD). Falls back to https://portfolio.elioflowra.com/ when empty.
NUXT_PUBLIC_SITE_URL=

# EmailJS (contact form, REST API). Leave empty and the form still renders, but every send fails with the "failed" toast.
# Template variables the form sends: {{name}} {{email}} {{topic}} {{message}}
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional overrides (defaults are in nuxt.config.ts → runtimeConfig.public):
# NUXT_PUBLIC_GTM_ID=
# NUXT_PUBLIC_GA4_ID=
